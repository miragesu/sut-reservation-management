# Copy to .env locally; never commit .env or real values.
APP_ENV=development
DATABASE_URL=sqlite:///./data/sut.db
# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_BEFORE_START
# Host port; container HTTP listener is fixed at port 80 (DEP-006).
APP_PORT=5088
# Loopback by default. On the server set its trusted LAN interface address.
APP_BIND=127.0.0.1
# false only for trusted development/LAN HTTP; true for HTTPS deployment.
COOKIE_SECURE=false
# Optional GitHub Remote Build path only: full reviewed source SHA.
SUT_GIT_REF=REPLACE_WITH_REVIEWED_FULL_COMMIT_SHA
# Primary image-only deployment: stable recommended once approved/published.
# Currently only 1.0.0 is verified published; installer confirms fallback.
SUT_VERSION=stable
# INSECURE opt-in for restricted LAN only: accepts 1–128 nonblank characters.
LOW_SECURITY_PASSWD=false

# Background deadline interval in seconds (0.1–60; production Compose enables it).
DEADLINE_POLL_SECONDS=1

# CONSOLE-001 remains OFF. Image-only opt-in uses a separate private console.env
# and the reviewed compose.console.yaml; see docs/console001/operator-runbook.md.
# Do not add Console activation to the coordination installer's private .env.
CONSOLE_ENABLED=false
CONSOLE_ACCESS_POLICY=claim_only
CONSOLE_ALLOW_INSECURE_HTTP=false
# KEK is Broker-only: never put keys in env/SQLite/Compose/source or mount into Web.
# Additional sensitive IPv4 exclusions remain operator configuration, not Lab CIDRs.
CONSOLE_SENSITIVE_IPV4=[]
